{
  "name": "Order",
  "description": "E-commerce order with nested customer and items",
  "fields": {
    "orderId": {
      "type": "string",
      "format": "uuid",
      "required": true
    },
    "orderDate": {
      "type": "string",
      "format": "date",
      "required": true
    },
    "customer": {
      "type": "object",
      "required": true,
      "fields": {
        "customerId": {
          "type": "string",
          "format": "uuid",
          "required": true
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100,
          "required": true
        },
        "email": {
          "type": "string",
          "format": "email",
          "required": true
        },
        "phone": {
          "type": "string",
          "pattern": "^\\+?1?\\d{10}$"
        }
      }
    },
    "items": {
      "type": "array",
      "required": true,
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "fields": {
          "productId": {
            "type": "string",
            "format": "uuid",
            "required": true
          },
          "productName": {
            "type": "string",
            "required": true
          },
          "quantity": {
            "type": "integer",
            "min": 1,
            "max": 100,
            "required": true
          },
          "price": {
            "type": "number",
            "min": 0.01,
            "required": true
          }
        }
      }
    },
    "totalAmount": {
      "type": "number",
      "min": 0.01,
      "required": true
    },
    "status": {
      "type": "string",
      "enum": ["pending", "processing", "shipped", "delivered", "cancelled"],
      "required": true
    },
    "shippingAddress": {
      "type": "object",
      "required": true,
      "fields": {
        "street": {
          "type": "string",
          "required": true
        },
        "city": {
          "type": "string",
          "required": true
        },
        "state": {
          "type": "string",
          "maxLength": 2
        },
        "zipCode": {
          "type": "string",
          "pattern": "^\\d{5}(-\\d{4})?$",
          "required": true
        },
        "country": {
          "type": "string",
          "required": true
        }
      }
    }
  }
}

